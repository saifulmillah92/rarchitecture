# frozen_string_literal: true

#
# ApplicationController
# Base controller for all HTML view endpoints.
# Inherits from Rarchitecture::ApplicationController::VIEW,
# which provides shared behavior and conventions for server-rendered pages.
#
# Features:
# - Centralized error handling (rescue_from StandardError)
# - Standard CRUD actions: index, new, edit, show, create, update, destroy
# - Input validation (validate!)
# - Service layer delegation (service, permitted_params)
# - Output handling and formatting (default_output, handle_exception)
# - Logging and failure capture (log_error, halt!)
#
# Use this as the common ancestor for all controllers rendering HTML views
# to ensure consistent behavior and reduce boilerplate.
class ApplicationController < Rarchitecture::ApplicationController::VIEW
